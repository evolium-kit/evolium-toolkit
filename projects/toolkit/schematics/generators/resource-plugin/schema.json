{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "EvoResourcePlugin",
  "title": "Plugin de serviço Evo",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do resource, no plural. Por exemplo: facturas.",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Nome do resource?"
    },
    "project": {
      "type": "string",
      "$default": { "$source": "projectName" }
    },
    "path": {
      "type": "string",
      "description": "Pasta onde criar. Omissão: <sourceRoot>/app/resources."
    },
    "dependsOn": {
      "type": "string",
      "description": "Plugins de que depende, separados por vírgula.",
      "default": "auth"
    },
    "endpoints": {
      "type": "string",
      "description": "Operações a gerar, separadas por vírgula.",
      "default": "list,get,create,update,remove"
    },
    "skipTests": {
      "type": "boolean",
      "default": false
    }
  },
  "required": ["name"]
}
