import { TestBed } from '@angular/core/testing';
<% if (temResource) { %>import { signal } from '@angular/core';
<% } %>import { provideRouter } from '@angular/router';
<% if (temResource) { %>import { EvoResourceRegistry } from '<%= toolkit %>/services';
<% } %>import { describe, expect, it } from 'vitest';
import { <%= classify(name) %>Page } from './<%= dasherize(name) %>.page';
<% if (temResource) { %>
/**
 * O resource vai em mock: o teste é da página, não do plugin. Sem isto o
 * `registry.get('<%= camelize(resource) %>')` rebenta, porque nenhum plugin está registado.
 */
const <%= camelize(resource) %> = { lista: signal([]), carregar: async () => undefined };
<% } %>
describe('<%= classify(name) %>Page', () => {
  it('monta e mostra um dos quatro estados', async () => {
    await TestBed.configureTestingModule({
      imports: [<%= classify(name) %>Page],
      providers: [
        provideRouter([]),
<% if (temResource) { %>        { provide: EvoResourceRegistry, useValue: { get: () => <%= camelize(resource) %> } },
<% } %>      ],
    }).compileComponents();

    const fixture = TestBed.createComponent(<%= classify(name) %>Page);
    fixture.detectChanges();

    expect(fixture.nativeElement.querySelector('h1')?.textContent).toContain('<%= classify(name) %>');
  });
});
